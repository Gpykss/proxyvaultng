# System Configuration
PORT=3000
SESSION_SECRET=proxyvault_super_secret_session_key_12345

# Mode Selection
# Set to 'true' to enable fully functional sandboxed simulations of Paystack, CyberYozh, and 5SIM APIs.
# Set to 'false' to connect to live production vendor APIs.
SIMULATION_MODE=true

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Proxy Vendor Configurations
CYBERYOZH_API_KEY=cy_api_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS Vendor Configurations
SMS_5SIM_API_KEY=5sim_api_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/proxyvault
