# System Configuration
PORT=3000
SESSION_SECRET=your_session_secret_key_here
CLIENT_URL=https://proxyvaultng.vercel.app

# Mode Selection
# Set to 'true' to enable sandboxed simulations.
# Set to 'false' to connect to live production vendor APIs.
SIMULATION_MODE=false

# Korapay Configuration
KORAPAY_SECRET_KEY=your_korapay_secret_key_here
KORAPAY_PUBLIC_KEY=your_korapay_public_key_here

# Proxy Vendor Configurations (CyberYozh)
CYBERYOZH_API_KEY=your_cyberyozh_api_key_here

# SMS Vendor Configurations (5SIM)
SMS_5SIM_API_KEY=your_5sim_api_key_here

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/proxyvault

# Telegram Support Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=-1000000000000

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@yourdomain.com
