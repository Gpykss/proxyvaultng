# System Configuration
PORT=3000
SESSION_SECRET=your_session_secret_key_here
CLIENT_URL=https://proxyvaultng.vercel.app

# Mode Selection
# Set to 'true' to enable sandboxed simulations.
# Set to 'false' to connect to live production vendor APIs.
SIMULATION_MODE=false

# Korapay Configuration
KORAPAY_SECRET_KEY=your_korapay_secret_key_here
KORAPAY_PUBLIC_KEY=your_korapay_public_key_here

# Proxy Vendor Configurations (Proxy-Seller ISP API)
PROXY_SELLER_API_KEY=your_proxy_seller_api_key_here
PROXY_SELLER_PAYMENT_ID=1

# Legacy Proxy Vendor Configurations (CyberYozh - Optional Fallback)
CYBERYOZH_API_KEY=your_cyberyozh_api_key_here

# SMS Vendor Configurations (5SIM)
SMS_5SIM_API_KEY=your_5sim_api_key_here

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/proxyvault

# Telegram Support Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=-1000000000000

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Proxy Pricing Configuration
# Set static proxy retail price in Naira (default: 7500). Update anytime.
PROXY_PRICE_NGN=7500

# Exchange Rate & Pricing Engine Settings
# Set base Google rate (e.g. 1365). If omitted, automatically fetches live rate.
USD_NGN_EXCHANGE_RATE=1365
# Naira buffer added on top of base exchange rate (default: 50)
FX_MARKUP_NAIRA=50
# Percentage buffer added on top of (base + buffer) (default: 0.005 for 0.5%)
FX_PERCENT_BUFFER=0.005
# Multipliers for pricing wholesale resources
PROXY_MARKUP_MULTIPLIER=1.6
SMS_MARKUP_MULTIPLIER=1.6

